# Local API server port. Render and many hosts provide PORT automatically.
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/smart_ecommerce
MongoDB_fallback=
MONGODB_FALLBACK_URI=
JWT_ACCESS_SECRET=replace-with-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-at-least-16-characters
CLIENT_URL=https://p-frontend-rho.vercel.app
LOG_LEVEL=info
