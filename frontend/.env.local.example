# Local backend pieces. Change NEXT_PUBLIC_BACKEND_PORT if backend PORT changes.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost
NEXT_PUBLIC_BACKEND_PORT=5000
NEXT_PUBLIC_API_PATH=/api

# For deployment, prefer one full backend API URL, for example:
# NEXT_PUBLIC_API_BASE_URL=https://smart-commerce-backend.onrender.com/api
NEXT_PUBLIC_APP_NAME=Smart Commerce
